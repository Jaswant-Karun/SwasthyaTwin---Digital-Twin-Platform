# SwasthyaTwin Environment Configuration
# Copy this file to .env to configure local environment settings (never commit .env)

# Application Environment
APP_ENV=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
DEMO_MODE=true

# MongoDB Configuration
# Local instance default:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=swasthyatwin

# For MongoDB Atlas (replace placeholders):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=SwasthyaTwin
# MONGODB_DATABASE=swasthyatwin

# Resilience & In-Memory Fallback
# If true and MongoDB daemon is unreachable, the backend falls back to an in-memory mongomock store
ALLOW_IN_MEMORY_FALLBACK=true

# Optional API Authentication (leave blank for development / hackathon open mode)
API_SECRET_KEY=

# Analytics Defaults
DEFAULT_BASELINE_DAYS=30
DEVIATION_SIGMA_THRESHOLD=2.0
