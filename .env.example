# SwasthyaTwin Environment Configuration
# Copy to .env for local overrides (never commit .env)

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=swasthya_twin
# If set to true, backend will automatically fall back to an in-memory/mock store if MongoDB is offline
ALLOW_IN_MEMORY_FALLBACK=true

# Analytics Defaults
DEFAULT_BASELINE_DAYS=30
DEVIATION_SIGMA_THRESHOLD=2.0
ENABLE_SYNTHETIC_AUTOSEED=true
