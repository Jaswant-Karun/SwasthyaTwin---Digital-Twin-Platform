# SwasthyaTwin Environment Configuration (Backend)
# Copy this file to .env to configure local backend settings

# Application Environment
APP_ENV=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
DEMO_MODE=true

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=swasthyatwin

# Fallback Configuration
ALLOW_IN_MEMORY_FALLBACK=true

# Optional API Authentication Key
API_SECRET_KEY=

# Analytics & Twin State Defaults
DEFAULT_BASELINE_DAYS=30
MIN_OBSERVATIONS_FOR_BASELINE=3
DEVIATION_SIGMA_THRESHOLD=1.8
DATA_STALENESS_WARNING_HOURS=48
DATA_STALENESS_CRITICAL_HOURS=168
ENABLE_SYNTHETIC_AUTOSEED=false
